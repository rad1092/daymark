{
  "name": "daymark",
  "version": "3.0.0-alpha.1",
  "private": true,
  "description": "A local daily planner built around three commitments and explicit rollover.",
  "type": "module",
  "scripts": {
    "dev": "npm run demo:dev",
    "build": "npm run demo:build",
    "preview": "vite preview --mode demo",
    "demo:dev": "vite --mode demo",
    "demo:build": "tsc -b && vite build --mode demo",
    "software:web:dev": "vite --mode software --port 1420",
    "software:web:build": "tsc -b && vite build --mode software",
    "software:dev": "tauri dev",
    "software:build": "tauri build",
    "software:build:debug": "tauri build --debug",
    "software:check": "tsc -b --pretty false && cargo check --manifest-path src-tauri/Cargo.toml",
    "software:smoke:macos": "bash scripts/smoke-macos-bundle.sh",
    "mobile:android:init": "tauri android init",
    "mobile:android:dev": "tauri android dev",
    "mobile:android:build": "tauri android build",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:dev": "tauri ios dev",
    "mobile:ios:build": "tauri ios build",
    "test": "vitest run --exclude scripts/retire-web.test.mjs",
    "test:watch": "vitest --exclude scripts/retire-web.test.mjs",
    "lint": "eslint . --max-warnings 0 && tsc -b --pretty false",
    "build:retired": "npm run demo:build && node scripts/retire-web.mjs",
    "test:retirement": "node --test scripts/retire-web.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
